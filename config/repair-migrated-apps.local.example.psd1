# ============================================================================
#  repair-migrated-apps.ps1 的「机器专属映射」模板
#
#  用法：复制到 <仓库根>\local\repair-migrated-apps.local.psd1，再按本机情况填写。
#        （local/ 已被 .gitignore 排除，填进去的真值不会进仓库。）
#
#  ⚠ 本文件是**唯一**放"旧路径 -> 新路径"映射的地方：脚本里刻意一条具体路径都不写
#    （硬性约定 8）。理由不是洁癖 —— 同一张表在别人机器上要么空转，要么把别人的登记
#    改写成另一个不存在的路径。所以**不填**时脚本会明确报"未执行有效检查"并以退出码 3
#    结束：那是"没查"，不是"没事"。
#
#  为什么是「数组 + Old/New」而不是哈希表：映射顺序敏感——更具体的前缀必须排在
#  更短的前面前面。psd1 不允许 [ordered]，数组才能保住顺序。
#
#  编码：本文件含中文，必须存成 **UTF-8 带 BOM**，否则 Windows PowerShell 5.1
#        会按 ANSI 解码导致乱码。
# ============================================================================
@{
    # 旧的"已登记路径前缀" -> 真实当前位置，一行一条。
    #   * 顺序敏感：更具体的在前。下面两条示例必须保持这个次序 —— 反过来的话通用的那条先命中，
    #     就会把 <程序>\resources 改到一个不存在的位置（写入前的存在性校验会把它报成"修不了"）。
    #   * New 里尽量**不要带版本号**：映射是"全表按序替换"，带版本号的具体条目会随程序升级腐烂
    #     ——先命中它、改到不存在的版本目录，而通用条目再也匹配不上。
    PathMap = @(
        # @{ Old = 'C:\Program Files (x86)\<程序>\resources';            New = '<程序根>\<程序>\app-<版本>\resources' },
        # @{ Old = 'C:\Program Files (x86)\<程序>';                      New = '<程序根>\<程序>' },
        # @{ Old = 'C:\Users\<旧用户名>\AppData\Local\Programs\<程序>';  New = '<程序根>\<程序>' },
        # @{ Old = 'D:\某个旧位置';                                      New = '<程序根>\新位置' }
    )

    # 用户目录改名：只在 HKCU\Software\Classes 下生效（URL 处理器等），
    # 绝不用于卸载记录——把死路径改成另一个死路径没有意义。带尾部反斜杠的那条必须排在前面。
    ProfileMap = @(
        # @{ Old = 'C:\Users\<旧用户名>\'; New = 'C:\Users\<当前用户名>\' },
        # @{ Old = 'C:\Users\<旧用户名>';  New = 'C:\Users\<当前用户名>' }
    )

    # 可选：整条缺失的"开始菜单快捷方式"（这类程序对"开始"搜索完全不可见）。
    #   未配置时脚本明确说"未做检查"，**不**打印空行假装检查过。
    # MissingShortcuts = @(
    #     @{ Name = '<开始菜单里显示的名字>'; Target = '<程序根>\<程序>\<程序>.exe' }
    # )

    # 可选：`repair` 跑完后的验收清单 —— 逐条核对这些"我修过的程序"还在不在（绝对路径，一行一条）。
    #   不配这一项时，脚本会明确说"本机验收清单：未配置"，**不会**打印一片 OK 假装检查过。
    #   为什么它属于本文件而不是脚本：这是**本机**清单。写死在脚本里会随程序搬家而腐烂
    #   （本机就曾因此每次跑都打一条假的 ABSENT），换台机器跑还会刷出一片假警报。
    # VerifyPaths = @(
    #     '<程序根>\<程序>\<程序>.exe'
    # )
}
